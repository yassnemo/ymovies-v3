{
  "name": "ymovies-svelte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5000",
    "dev:simple": "npm run dev",
    "dev:client": "npm run dev",
    "build": "vite build",
    "build:clean": "vite build",
    "build:vercel": "vite build",
    "build:heroku": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local build/index.js",
    "start:heroku": "node build/index.js",
    "heroku-postbuild": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/testing/test-api.js",
    "test:browser": "node scripts/testing/browser-smoke.mjs",
    "db:push": "drizzle-kit push",
    "format": "prettier --write src tests vite.config.ts tailwind.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.15.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vite": "^8.3.8"
  }
}
