{
  "extends": "$app/tsconfig",
  "include": ["src", "server", "shared", "tests", "types", "*.ts"],
  "exclude": ["node_modules", "build", "dist", ".temp", "client"],
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  }
}
